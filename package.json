{
  "name": "apk-kas-flexbox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5194 --strictPort",
    "build": "node scripts/check-env.mjs && node scripts/build-icons.mjs && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5194 --strictPort",
    "test": "node --test tests/*.mjs",
    "icons": "node scripts/build-icons.mjs",
    "setup:accounts": "node --env-file=.env.local scripts/setup-accounts.mjs",
    "setup:push": "node scripts/generate-push-keys.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@resvg/resvg-js": "^2.6.2",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "fflate": "^0.8.3",
    "web-push": "^3.6.7"
  }
}
